# საჯარო გასაღები. იგივე მნიშვნელობაა Supabase Dashboard → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# მხოლოდ სერვერისთვის. არასდროს დაამატოთ NEXT_PUBLIC_ პრეფიქსი და არ გამოიყენოთ ბრაუზერში.
SUPABASE_SERVICE_ROLE_KEY=

# ლოკალურად: http://localhost:3000
# Vercel-ზე: თქვენი საიტის სრული მისამართი, მაგალითად https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
